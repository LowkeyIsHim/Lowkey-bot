# Set these as env vars on Spaceify (or copy to .env for local runs). Never commit real keys.
TELEGRAM_BOT_TOKEN=            # from @BotFather
TELEGRAM_OWNER_ID=             # your numeric Telegram ID (message the bot /myid)
GEMINI_API_KEY=                # optional: without it the bot uses the local quote bank
GEMINI_MODEL=gemini-2.5-flash
BOT_TZ=Africa/Lagos
RUN_TIME=06:00                 # default daily drop, change live with /settime
POSTS_PER_DAY=3
NO_REPEAT_DAYS=30
HASHTAGS_MIN=6
HASHTAGS_MAX=9
